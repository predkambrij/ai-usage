# Copy to .env and fill in. .env is gitignored.
ZAI_API_KEY=your-z.ai-api-key-here

# Optional overrides (see ./ai-usage.sh --help):
#ZAI_API_BASE=https://api.z.ai
#ZAI_QUOTA_URL=
#ZAI_API_URL=
#ZAI_MODEL=glm-5
#ZAI_SERVER_TZ=Asia/Shanghai

# Optional daily billing override; normally discovered from the API account:
#ZAI_CUSTOMER_ID=

# Claude config dir for ./ai-usage.sh claude (default ~/.claude):
#CLAUDE_CONFIG_DIR=

# Codex home for ./ai-usage.sh codex (default ~/.codex):
#CODEX_HOME=
